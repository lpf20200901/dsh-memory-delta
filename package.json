{
  "name": "dsh-memory-delta",
  "version": "1.0.0",
  "description": "Layered, auto-injected cross-session memory for AI coding agents: a DSH plugin plus a standalone zero-dependency CLI. Borrows the spec/change/archive discipline from OpenSpec (MIT), but pushes instead of pulls.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpf20200901/dsh-memory-delta.git"
  },
  "homepage": "https://github.com/lpf20200901/dsh-memory-delta#readme",
  "bugs": {
    "url": "https://github.com/lpf20200901/dsh-memory-delta/issues"
  },
  "type": "module",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./cli": "./bin/mem.mjs",
    "./panel": "./src/panel.mjs",
    "./planner": "./src/planner.mjs",
    "./hook": "./src/hook.mjs",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "mem": "./bin/mem.mjs"
  },
  "files": [
    "bin",
    "assets",
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --check src/plugin.mjs && node --check src/panel.mjs && node --check client/client.js && node test/run-tests.mjs && node test/planner-tests.mjs && node test/search-tests.mjs && node test/due-tests.mjs && node test/hook-tests.mjs && node --import ./test/stub-loader.mjs test/plugin-tests.mjs && node test/client-tests.mjs"
  },
  "keywords": [
    "memory",
    "agent",
    "dsh",
    "deepseek-harness",
    "spec-driven",
    "context",
    "cordis-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
